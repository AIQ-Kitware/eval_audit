# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenv / packaging
# .venv*/ also covers scratch envs like .venv-1, .venv-test, .venv_eval_audit
.venv*/
venv/
build/
dist/
*.egg-info/
# docker/build.sh staging context (pristine git-archived source for the runner
# image). Regenerated on every build; never a tracked source.
/.build-staging/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Generated experiment outputs
# Leading "/" anchors to the repo root. The previous "./X/" spelling is
# not valid gitignore syntax and matched nothing.
/reports/
/results/
/data/
/audit-smoke/
/audit-smoke-apples/
/benchmark_sankeys/
/helm_id_*/

# Misc local scratch
tmp/
out.txt
/output.txt
/todo
outputs.json
run_infos.json
run_infos.yaml
rundiff.jsonl

in-progress-notes/
# Repo-root reports/ only — an unanchored "reports/" pattern would be
# over-broad and match eval_audit/reports/ (the package subdir). The
# anchored /reports/ under "Generated experiment outputs" covers the
# repo-level output dir.
old-backup-reports/
.cache
.claude

# symlink to directory with reports
crfm-helm-audit-store
paper_draft
# validation-ladder machine-local output (dev/era-tests/ writes ERA_OUT here)
ladder-out/
# scratch dir some contributors keep at the repo root
uncommitted
# generated transfer/source archives (package-analyses.sh, archive-source.sh)
/eval-audit-analyses.tar.zst
/eval_audit-source-*.tar.gz
/docs/*.zip
