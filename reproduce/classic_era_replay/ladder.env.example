# Ladder environment contract — copy to ladder.env on the target machine and
# fill in. Every ladder script sources reproduce/classic_era_replay/ladder.env
# if it exists, so the scripts themselves NEVER need editing per machine.
# 05_ladder_gate.sh runs every rung this file enables and SKIPs the rest,
# printing exactly which variable unlocks each skipped rung.

# --- required for everything beyond tier 0 (host-only tests) -----------------
# Era keys to validate (space-separated; both classic eras by default).
LADDER_ERAS="helm-v0.2.4 helm-v0.3.0"
# Public HELM corpus mirror on this machine.
PRECOMPUTED_ROOT=/data/crfm-helm-public

# --- optional / rung-specific ------------------------------------------------
# Prefix that configs/run_details.yaml run_dir paths carry (only change if your
# mirror was indexed under a different canonical path).
#CANONICAL_CORPUS_PREFIX=/data/crfm-helm-public
# HF cache to mount into rung-2/5 containers (default: ./ladder-out/hf-cache).
# Point at a warmed cache to run rung 5 offline.
#HF_CACHE_DIR=/data/hf-cache
# Output root for ladder artifacts (default: <repo>/ladder-out).
#LADDER_OUT=/tmp/era-ladder-out
# Explicit era image ref (default: <image_name from docker/eras.yaml>:dev,
# built by 00_build_era_image.sh). Set per-run when using digest-pinned images.
#ERA_IMAGE=helm-runner-era-v0-3-0:dev
# Adaptation cap for the rung-5 fetch audit (fetch still covers the full dataset).
#LADDER_FETCH_CAP=10

# --- rung 3-4 (end-to-end; needs GPU serving) --------------------------------
# Fill these to let the gate drive 10_export_bundle / 20_make_manifest / 30_run.
#ERA_PRESET=<infer-stack preset for the era model>
#SOURCES_FPATH=<frozen run_spec_sources yaml from the exported bundle>
#IMAGE_REF=<era image ref to pin in the manifest>
#EVAL_AUDIT_ERA_API_KEY=EMPTY
